# Copy to .env and fill in. Real keys never go in the repo.

# ---------- Backend ----------
# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-api-key-1,your-api-key-2
# LiteLLM model name used by every key
LLM_MODEL=gemini/gemini-2.5-flash
# Optional: one model per key, aligned with LLM_API_KEYS (overrides LLM_MODEL)
LLM_MODELS=
# SQLite location (Docker volume mounted at /data)
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# true enables the X-Simulate-Failure test hook
ENABLE_FAILURE_SIMULATION=true
# Default system prompt for sessions that do not set one
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.
# LiteLLM in-memory response cache lifetime
CACHE_TTL_SECONDS=86400
# Per-key request timeout and back-off after a real 429/5xx
LLM_TIMEOUT_SECONDS=30
KEY_COOLDOWN_SECONDS=30
# Number of past messages sent to the model as context
MAX_HISTORY_MESSAGES=40
MAX_OUTPUT_TOKENS=1024

# ---------- Frontend (build time) ----------
VITE_API_BASE_URL=http://localhost:8000
